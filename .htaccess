# tischkraft.de auf Plesk (Apache). Stand 2026-11-24.
# Eine Adresse: https://tischkraft.de ohne www (Canonical, Sitemap). Entscheidung 2026-11-24.
# Plesk (bevorzugte Domain) leitet ebenfalls www → ohne www; gleiche Richtung, keine Schleife.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.tischkraft\.de$ [NC]
RewriteRule ^ https://tischkraft.de%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Alte WordPress-/WooCommerce-Adressen
RedirectMatch 301 ^/firmenkunden/?$ /firmenfeier/
RedirectMatch 301 ^/(shop|produkt|product|produkt-kategorie|warenkorb|kasse|versand-und-zahlung)(/.*)?$ /mieten/
RedirectMatch 301 ^/(kontakt|ueber-uns|mein-konto)/?$ /
RedirectMatch 301 ^/widerrufsbelehrung/?$ /agb/
RedirectMatch 301 ^/(wp-admin|wp-login\.php|wp-content|wp-includes|feed|sitemaps\.xml|wp-sitemap\.xml)(/.*)?$ /

ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType text/plain;charset=utf-8 .txt

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>
